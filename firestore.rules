rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ADMIN CONFIGURATION
    // =========================================================================

    // NOTE FOR ADMIN: Replace 'CHANGE_ME@gmail.com' below with your verified admin email!
    function isAdmin() {
      return request.auth != null
        && 'email' in request.auth.token
        && (
          request.auth.token.email.lower() == 'bhanu2006v@gmail.com'
          || request.auth.token.email == 'bhanu2006v@gmail.com'
        );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Ensures the user has not been blocked by an administrator
    function isNotBlocked() {
      return isAuthenticated()
        && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid));
    }

    // =========================================================================
    // 1. BLOCKED USERS COLLECTION: blocked/{uid}
    // =========================================================================
    match /blocked/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. USERS COLLECTION: users/{uid}
    // =========================================================================
    match /users/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && isNotBlocked() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (isAuthenticated() && isNotBlocked() && request.auth.uid == uid);
      allow delete: if isAdmin() || (isAuthenticated() && isNotBlocked() && request.auth.uid == uid);
    }

    // =========================================================================
    // 3. PLAYLISTS COLLECTION: playlists/{playlistId}
    // =========================================================================
    match /playlists/{playlistId} {
      allow read: if isAdmin()
        || resource.data.visibility == 'public'
        || resource.data.isPublic == true
        || (isAuthenticated() && isNotBlocked() && (
          request.auth.uid == resource.data.ownerUid
          || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        ));

      allow create: if isAdmin()
        || (isAuthenticated() && isNotBlocked() && request.resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        || (isAuthenticated() && isNotBlocked() && (
          request.auth.uid == resource.data.ownerUid
          || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
          || resource.data.collabEnabled == true
        ));

      allow delete: if isAdmin()
        || (isAuthenticated() && isNotBlocked() && request.auth.uid == resource.data.ownerUid);
    }

    // =========================================================================
    // 4. INVITE CODES COLLECTION: inviteCodes/{code}
    // =========================================================================
    match /inviteCodes/{code} {
      allow read: if isAuthenticated() && isNotBlocked();
      allow create: if isAdmin() || (isAuthenticated() && isNotBlocked() && request.resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && isNotBlocked() && resource.data.createdBy == request.auth.uid);
    }
  }
}

