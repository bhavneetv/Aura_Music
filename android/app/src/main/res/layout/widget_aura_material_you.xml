<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Album Art Thumbnail -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/widget_art_rounded"
        android:clipToOutline="true"
        android:contentDescription="Album Art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_default_art" />

    <!-- Track Title and Artist -->
    <LinearLayout
        android:id="@+id/widget_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Aura Music"
            android:textColor="#FFFFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap to play music"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ready"
            android:textColor="#A78BFA"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Interactive Playback Controls -->
    <LinearLayout
        android:id="@+id/widget_controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev" />

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_play_circle"
            android:contentDescription="Play/Pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Next"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
