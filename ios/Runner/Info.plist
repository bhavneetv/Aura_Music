<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Aura</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Aura</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSSiriUsageDescription</key>
	<string>Aura uses Siri to let you play songs, artists, and playlists using voice commands.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Aura uses your local network to discover and sync audio playback with nearby devices on your Wi-Fi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Aura requires microphone access for voice assistant commands.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Aura requires speech recognition to understand your voice commands.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Aura uses Bluetooth to connect to external speakers and audio devices.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Aura uses Bluetooth to stream music to external audio devices.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Aura accesses your media library for playback and recommendations.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Aura accesses your photos to let you choose custom playlist artwork.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Aura saves artwork and audio share cards to your photo library.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INPlayMediaIntent</string>
		<string>INSearchForMediaIntent</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.example.musicApp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aura</string>
				<string>aura-playlist</string>
				<string>auramusic</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
